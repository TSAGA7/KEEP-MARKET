# Публичные переменные фронтенда (попадают в сборку — НЕ кладите сюда секреты!)
# Service role key и токен бота сюда добавлять ЗАПРЕЩЕНО.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Базовый путь для GitHub Pages: /<имя-репозитория>/ (локально — /)
VITE_BASE_PATH=/
# Страница тестовой оплаты — только для development вместе с PAYMENT_PROVIDER=mock на сервере
VITE_ENABLE_MOCK_PAYMENT=false
# Только для локальной разработки вне Telegram: initData, подписанная ТЕСТОВЫМ ботом (scripts/dev-init-data.mjs)
VITE_DEV_INIT_DATA=
