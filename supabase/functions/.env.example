# Секреты Edge Functions. Локально: supabase functions serve --env-file supabase/functions/.env
# В облаке: supabase secrets set --env-file supabase/functions/.env   (файл .env НЕ коммитить!)
APP_ENV=development                      # production | development
APP_PUBLIC_URL=http://localhost:5173     # публичный адрес фронтенда (GitHub Pages), без завершающего /
APP_ORIGINS=http://localhost:5173        # разрешённые Origin для CORS через запятую
APP_JWT_SECRET=                          # JWT Secret проекта Supabase (Settings → API → JWT Settings), ≥32 символов
TELEGRAM_BOT_TOKEN=                      # токен от @BotFather
TELEGRAM_BOT_USERNAME=                   # username бота без @
TELEGRAM_APP_SHORT_NAME=                 # short name Mini App из /newapp (для ссылок t.me/<bot>/<app>)
TELEGRAM_WEBHOOK_SECRET=                 # случайная строка 32+ символов [A-Za-z0-9_-]
INIT_DATA_MAX_AGE_SECONDS=86400
SESSION_TTL_SECONDS=43200
PAYMENT_PROVIDER=none                    # none | mock (только development) | yookassa
MOCK_PAYMENT_SECRET=                     # для mock: случайная строка 16+ символов
MOCK_CHECKOUT_URL=http://localhost:5173/dev/mock-payment
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SEND_RECEIPT=false              # true — передавать данные чека (54-ФЗ) через ЮKassa
YOOKASSA_VAT_CODE=1                      # код НДС для чека — уточнить у бухгалтера
YOOKASSA_ALLOWED_IPS=                    # IP/подсети уведомлений ЮKassa через запятую (см. docs/payments.md)
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY задаются платформой автоматически
